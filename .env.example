PORT=5050
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Server-only Supabase credentials. Never expose the service-role key in Vite.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack webhook verification and transaction verification.
PAYSTACK_SECRET_KEY=sk_test_replace_me

# Encrypts bank account numbers at rest (payout_accounts.account_number_cipher).
# REQUIRED for bank account setup and withdrawals. AES-256-CBC.
# Recommended format: 64-char hex (= 32 bytes). Generate with:
#   node scripts/generateEncryptionKey.js   (or: openssl rand -hex 32)
# Paste the value EXACTLY — no surrounding quotes, no trailing newline.
# MUST be identical across every environment sharing the same database.
ACCOUNT_ENCRYPTION_KEY=replace_with_64_char_hex
# Optional: set during a key rotation to the OLD key so existing records still
# decrypt while new records use ACCOUNT_ENCRYPTION_KEY. Remove once
# scripts/reencryptPayoutAccounts.js --apply has migrated all rows.
# ACCOUNT_ENCRYPTION_KEY_PREVIOUS=old_key_value

# Generate once with: npx web-push generate-vapid-keys
# Keep the same key pair across deployments. The frontend fetches the public
# key from GET /api/push/vapid-public-key.
VAPID_PUBLIC_KEY=replace_me
VAPID_PRIVATE_KEY=replace_me
VAPID_SUBJECT=mailto:support@example.com

# Must match BACKEND_NOTIFY_SECRET in the verify-paystack-payment Edge Function.
INTERNAL_NOTIFY_SECRET=replace_with_a_long_random_value

# Transactional email (Nodemailer SMTP). Currently ZeptoMail, but the var
# names are kept as ZOHO_* for backwards compatibility with earlier Zoho SMTP
# usage. Used by services/emailService.js for all NON-ambassador transactional
# emails (deposits, withdrawals, KYC, security, etc). Ambassador Program
# emails use their own isolated AMBASSADOR_SMTP_* credentials below — do NOT
# reuse these for ambassador emails.
ZOHO_EMAIL=replace_with_smtp_username
ZOHO_APP_PASSWORD=replace_with_smtp_app_password
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_SECURE=false
FROM_EMAIL=noreply@kolekto.com.ng
# Support address surfaced in ambassador emails; falls back to team@kolekto.com.ng if unset.
SUPPORT_EMAIL=team@kolekto.com.ng

# Comma-separated fallback admin emails, used by utils/requireAdmin.js when the
# admin_users table is empty/unreachable, and for admin-facing notifications.
ADMIN_EMAILS=admin@example.com

# Dedicated ZeptoMail Mail Agent for the Ambassador Program ONLY. Fully
# isolated from the ZOHO_* credentials above — separate transporter
# (utils/ambassadorMailer.js), separate failure domain. A problem with one
# mail agent must never affect the other. Used for all 9 ambassador lifecycle
# emails (application received, interview scheduled, accepted, rejected,
# suspended, reactivated, withdrawal requested/approved/paid) via
# utils/ambassadorEmailer.js.
AMBASSADOR_SMTP_HOST=replace_with_zeptomail_smtp_host
AMBASSADOR_SMTP_PORT=587
AMBASSADOR_SMTP_USER=replace_with_ambassador_smtp_username
AMBASSADOR_SMTP_PASS=replace_with_ambassador_smtp_password
AMBASSADOR_SMTP_FROM=ambassadors@kolekto.com.ng
AMBASSADOR_SMTP_FROM_NAME=Kolekto Ambassador Program

# Dedicated ZeptoMail Mail Agent for the Email Campaign / Communications
# system ONLY ("Kolekto Marketing"). Fully isolated from both ZOHO_* and
# AMBASSADOR_SMTP_* above — separate transporter (utils/marketingMailer.js),
# separate failure domain, so bulk campaign sends can never affect
# transactional deliverability or Ambassador lifecycle emails.
MARKETING_SMTP_HOST=replace_with_zeptomail_smtp_host
MARKETING_SMTP_PORT=587
MARKETING_SMTP_USER=replace_with_marketing_smtp_username
MARKETING_SMTP_PASS=replace_with_marketing_smtp_password
MARKETING_SMTP_FROM=news@kolekto.com.ng
MARKETING_SMTP_FROM_NAME=Kolekto

# Email campaign send-queue worker (jobs/emailCampaignQueue.js). Set
# RUN_EMAIL_QUEUE_CRON=true on exactly ONE replica — same single-leader
# convention as RUN_SETTLEMENT_CRON, since there's no distributed lock across
# replicas and duplicate sends must never happen.
RUN_EMAIL_QUEUE_CRON=false
EMAIL_QUEUE_BATCH_SIZE=25

# Shared secret ZeptoMail must send back on its delivery-event webhook
# (POST /api/adminurlabdkole/email/webhooks/zeptomail?token=...). Generate
# with: openssl rand -hex 32. Configure the same value + this URL in the
# "Kolekto Marketing" Mail Agent's webhook settings in the ZeptoMail
# dashboard once you're ready to enable open/click/bounce tracking.
ZEPTOMAIL_WEBHOOK_TOKEN=replace_with_a_long_random_value

# This backend's own public URL — needed to build absolute links (e.g.
# {{unsubscribe_link}}) that work from inside an email client, where a
# relative path has no meaning. MUST be the real deployed backend URL
# before sending real campaign traffic; falls back to localhost in dev.
BACKEND_PUBLIC_URL=http://localhost:5050

# Signs/verifies {{unsubscribe_link}} tokens (utils/unsubscribeTokens.js).
# Falls back to INTERNAL_NOTIFY_SECRET if unset, and to an insecure dev-only
# value if neither is set — set this explicitly before sending real
# campaign traffic. Generate with: openssl rand -hex 32
UNSUBSCRIBE_SECRET=replace_with_a_long_random_value
